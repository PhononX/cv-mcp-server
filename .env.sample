# Stdio auth. Provide ONE of these; CARBON_VOICE_PAT wins if both are set.
# A PAT is preferred: it expires, is revocable, and is self-service via
# POST /pats, whereas an API key is long-lived and carries your full identity.
# Note its cv:read / cv:write scopes are NOT a restriction today — cv-api only
# enforces them on the app subscribe/unsubscribe endpoints, so a cv:read PAT
# can still write. Treat a PAT as full access that you can revoke, not as a
# limited one. Neither is used by the HTTP transport, which uses OAuth.
# CARBON_VOICE_PAT=cv_pat_...
# Only stdio uses it.
CARBON_VOICE_API_KEY=SUPER_SECRET
CARBON_VOICE_BASE_URL=https://api.carbonvoice.app
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_TRANSPORT=file
# Set to false when running the stateless transport (start:http:stateless / dev:http:stateless).
# The stateless npm scripts set this automatically — only override here if needed.
# MCP_SESSION_LOGS_ENABLED=true

# create_voicememo_message audio_url fetching.
# Set AUDIO_FETCH_ALLOWED_HOSTS in production: it restricts which hosts the
# server will fetch audio from. Unset means any public host over https
# (private, loopback and link-local addresses are always refused, and plain
# http is refused unless the host is named here).
#
# Naming hosts here is the strongest control available: the address checks and
# the connection are two separate DNS lookups, so a caller controlling a
# hostname's DNS can in principle answer them differently (rebinding). An
# allowlist means they would have to control DNS for a host you chose.
# AUDIO_FETCH_ALLOWED_HOSTS=cdn.example.com,uploads.example.com
# AUDIO_FETCH_MAX_BYTES=26214400
# AUDIO_FETCH_TIMEOUT_MS=30000
# How many audio fetches may be in flight across the whole process.
# MAX_BYTES caps one fetch; this caps their sum. The tool-call queue serializes
# per session, so without it one caller with several sessions could hold
# gigabytes of transient memory. Defaults to 4.
# AUDIO_FETCH_MAX_CONCURRENT=4
