CARBON_VOICE_API_KEY=SUPER_SECRET # Only stdio uses it
CARBON_VOICE_BASE_URL=https://api.carbonvoice.app
LOG_LEVEL=debug
LOG_DIR=./logs
LOG_TRANSPORT=file
# Set to false when running the stateless transport (start:http:stateless / dev:http:stateless).
# The stateless npm scripts set this automatically — only override here if needed.
# MCP_SESSION_LOGS_ENABLED=true

# create_voicememo_message audio_url fetching.
# Set AUDIO_FETCH_ALLOWED_HOSTS in production: it restricts which hosts the
# server will fetch audio from. Unset means any public host (private, loopback
# and link-local addresses are always refused).
# AUDIO_FETCH_ALLOWED_HOSTS=cdn.example.com,uploads.example.com
# AUDIO_FETCH_MAX_BYTES=26214400
# AUDIO_FETCH_TIMEOUT_MS=30000
